{
  "kind": "collectionType",
  "collectionName": "service_pages",
  "info": {
    "singularName": "service-page",
    "pluralName": "service-pages",
    "displayName": "Service Page",
    "description": "Advisory and communications service pages"
  },
  "options": { "draftAndPublish": false },
  "attributes": {
    "title":           { "type": "string", "required": true },
    "slug":            { "type": "uid", "targetField": "title", "required": true },
    "hero_heading":    { "type": "string" },
    "hero_subheading": { "type": "string" },
    "hero_image":      { "type": "media", "multiple": false, "allowedTypes": ["images"] },
    "overview_image":  { "type": "media", "multiple": false, "allowedTypes": ["images"] },
    "overview_heading": { "type": "text" },
    "body_content":    { "type": "blocks" },
    "stat_headline_label": { "type": "string" },
    "stat_headline_value": { "type": "string" },
    "stats": {
      "type": "component",
      "repeatable": true,
      "component": "shared.stat"
    },
    "media_band_image": { "type": "media", "multiple": false, "allowedTypes": ["images"] },
    "quote_text":   { "type": "text" },
    "quote_author": { "type": "string" },
    "quote_role":   { "type": "string" },
    "quote_image":  { "type": "media", "multiple": false, "allowedTypes": ["images"] },
    "highlights": {
      "type": "component",
      "repeatable": true,
      "component": "shared.highlight"
    },
    "sections": {
      "type": "component",
      "repeatable": true,
      "component": "shared.content-section"
    },
    "faq_items": {
      "type": "component",
      "repeatable": true,
      "component": "shared.faq-item"
    },
    "meta_title":       { "type": "string" },
    "meta_description": { "type": "text" }
  }
}
