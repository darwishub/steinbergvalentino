{
  "kind": "collectionType",
  "collectionName": "exchange_pages",
  "info": {
    "singularName": "exchange-page",
    "pluralName": "exchange-pages",
    "displayName": "Exchange Page",
    "description": "Stock exchange IR pages (NASDAQ, OTC, TSX, CSE, Frankfurt)"
  },
  "options": { "draftAndPublish": false },
  "attributes": {
    "title":           { "type": "string", "required": true },
    "slug":            { "type": "uid", "targetField": "title", "required": true },
    "exchange_name":   { "type": "string" },
    "country":         { "type": "string" },
    "hero_heading":    { "type": "string" },
    "hero_subheading": { "type": "string" },
    "hero_image":      { "type": "media", "multiple": false, "allowedTypes": ["images"] },
    "body_content":    { "type": "blocks" },
    "sections": {
      "type": "component",
      "repeatable": true,
      "component": "shared.content-section"
    },
    "faq_items": {
      "type": "component",
      "repeatable": true,
      "component": "shared.faq-item"
    },
    "meta_title":       { "type": "string" },
    "meta_description": { "type": "text" }
  }
}
